// Modelul de date — sursa structurii DB (house standard).
// Orice schimbare aici → o migrare: `npm run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

// Conexiunea (DATABASE_URL) se configurează în prisma.config.ts (Prisma 7+).
datasource db {
  provider = "postgresql"
}

// --- Autentificare (better-auth) ---
// Modele cerute de better-auth. `role` e adăugat pentru RBAC minim (task 1.1).
// Nu edita manual câmpurile cerute de better-auth fără a regenera cu CLI-ul.

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          String       @default("user")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  documents     Document[]
  consents      Consent[]
  signedForms   SignedForm[]
  dossiers      Dossier[]
  reminders     Reminder[]
  vehicule      Vehicul[]
  imobile       Imobil[]

  @@map("user")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// --- Model canonic „cetățean" (task 1.2) ---
// Sursa unică de date; formularele nu au date proprii, doar mapare (SPEC).
// Câmpurile tari (CNP, serie/nr CI, IBAN) se stochează CRIPTAT per-câmp
// (ADR 0005): coloanele `*Enc` conțin payload `v1:...`, niciodată în clar.
// Numele rămâne în clar (ca la User) — necesar pentru afișare/mapare; scopul
// de criptare v1 sunt identificatorii tari (vezi docs/threat-model.md).

enum AddressType {
  DOMICILIU
  RESEDINTA
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nume         String?
  prenume      String?
  sex          String?
  dataNasterii DateTime?

  // Identificatori tari — criptați per-câmp.
  cnpEnc     String?
  ciSerieEnc String?
  ciNrEnc    String?
  ciEmitent  String?
  ciExp      DateTime?

  // Contact.
  telefon String?
  ibanEnc String?

  addresses Address[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("profile")
}

model Address {
  id         String      @id @default(cuid())
  profileId  String
  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tip        AddressType
  strada     String?
  nr         String?
  localitate String?
  uat        String?
  judet      String?
  codPostal  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("address")
}

// --- Seif de documente (task 1.3) ---
// Scanurile (CI, CIV, contracte) se stochează CRIPTAT (ADR 0005) cu retenție
// definită (ștergere după utilizare — GDPR). `contentEnc` = payload `v1:...` al
// bytes-ilor (base64). Conținutul se accesează doar prin repository, cu
// verificare de proprietate.

model Document {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip         String // CI | CIV | CONTRACT | ALTUL
  filename    String
  mimeType    String
  sizeBytes   Int
  contentEnc  String // bytes criptați (envelope), niciodată în clar
  retainUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([retainUntil])
  @@map("document")
}

// --- GDPR: consimțământ + audit (task 1.4) ---
// Consent ledger: o înregistrare per acordare, cu versiunea politicii; retragerea
// setează `withdrawnAt`. Consimțământul activ = cea mai recentă acordare a
// categoriei fără retragere.

model Consent {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      String // IDENTITATE | DOCUMENTE | CONTACT
  policyVersion String
  grantedAt     DateTime  @default(now())
  withdrawnAt   DateTime?

  @@index([userId])
  @@map("consent")
}

// Audit log FĂRĂ PII și FĂRĂ FK către user — supraviețuiește ștergerii contului
// (dovadă de conformitate). Conține doar id opac + acțiune + detaliu neutru.

model AuditLog {
  id        String   @id @default(cuid())
  userId    String? // opac; poate rămâne după ștergerea contului
  action    String // CONSENT_GRANT | CONSENT_WITHDRAW | DATA_EXPORT | DATA_DELETE | ACCOUNT_DELETE
  detail    String? // neutru (ex. categoria) — niciodată PII
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_log")
}

// --- Formulare semnate + arhivate (task 1.6) ---
// Documentul semnat se stochează CRIPTAT (envelope, AAD=user), cu hash-ul de
// integritate și metadatele semnăturii. Provider mock în dev; QTSP real (CSC)
// în spatele aceleiași abstracții — ADR 0010.

model SignedForm {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formCode    String
  manifestId  String
  provider    String // mock | certsign | transsped
  status      String // SIGNED
  contentHash String // sha256 al PDF-ului semnat (integritate)
  contentEnc  String // bytes semnați, criptați
  signedAt    DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("signed_form")
}

// --- Dosare (dispatch + handoff, task 1.7) ---
// Un dosar = un caz de depunere pentru un formular. Urmărește starea până la
// „butonul de trimitere": DE_DEPUS → DEPUS (declarat de user — „generate, don't
// submit"). Handoff-ul (checklist + canale) se derivă din manifest, nu se stochează.

model Dossier {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formCode     String
  manifestId   String
  signedFormId String?
  status       String // DE_DEPUS | DEPUS
  submittedAt  DateTime?
  deadline     String? // informativ (ex. „25 mai")
  deadlineAt   DateTime? // termen calculat (pentru remindere)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@map("dossier")
}

// --- Remindere de termen (task 1.8) ---
// Generate de un job pg-boss (src/jobs/) pentru dosarele „de depus" cu termen
// apropiat. Unic per (dosar, prag) — idempotent. Fără PII.

model Reminder {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossierId  String
  kind       String // T30 | T7 | T1 (zile până la termen)
  formCode   String
  deadlineAt DateTime
  createdAt  DateTime @default(now())

  @@unique([dossierId, kind])
  @@index([userId])
  @@map("reminder")
}

// --- Entitatea Vehicul (Faza 2 — dosar auto, task 2.1) ---
// Câmpurile din SPEC. ITL-005 Cluj (rev. 2026) cere normă poluare, emisii CO₂
// (hibride) și putere (electrice) — de aceea sunt modelate explicit. Datele de
// vehicul nu sunt „date protejate" (ca CNP/CI) → stocate în clar.

model Vehicul {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vin             String?
  marca           String?
  model           String?
  nrInmatriculare String?
  civSerie        String?
  serieMotor      String?
  cilindreeCm3    Int?
  masaMaximaKg    Int?
  anFabricatie    Int?
  combustibil     String? // BENZINA | MOTORINA | HIBRID | ELECTRIC | GPL | ...
  normaPoluare    String? // ex. Euro 6
  emisiiCo2GKm    Int?
  putereKw        Int?
  dataDobandire   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@map("vehicul")
}

// --- Entitatea Imobil (Faza 3 — C168 închiriere, task 3.1) ---
// Proprietatea (apartament/casă/teren). Termenii de închiriere (chirie, monedă,
// perioadă, chiriași) NU stau aici — vin ca inputuri la C168. Datele de imobil
// nu sunt „date protejate" (ca CNP/CI) → stocate în clar.

model Imobil {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip             String // APARTAMENT | CASA | TEREN | SPATIU_COMERCIAL | ALTUL
  judet           String?
  localitate      String?
  strada          String?
  nr              String?
  bloc            String?
  scara           String?
  etaj            String?
  apartament      String?
  codPostal       String?
  suprafataMp     Int?
  nrCadastral     String?
  nrCarteFunciara String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@map("imobil")
}

// Fereastră de rate-limit (backstop distribuit, partajat între instanțe, pe
// rutele autentificate de generare). Contor pe fereastră fixă. Cheia e opacă
// (ex. „gen:<userId>") — FĂRĂ PII. Ferestrele vechi se curăță de jobul de retenție.
model RateLimitWindow {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_window")
}

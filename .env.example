# Bază de date
DATABASE_URL="postgresql://app:app@localhost:5432/app"

# Criptare per-câmp (envelope encryption) — 32 de bytes codate base64.
# Generează una cu: openssl rand -base64 32
# Obligatorie în producție. În dev poate lipsi până folosești criptarea.
ENCRYPTION_MASTER_KEY=""

# better-auth (doar dacă proiectul are autentificare)
# În producție: minim 32 de caractere. Generează cu: openssl rand -base64 32
BETTER_AUTH_SECRET="schimba-ma"
BETTER_AUTH_URL="http://localhost:3000"

# Email tranzacțional (ex. Resend) — opțional
# RESEND_API_KEY=""
